# 项目损益账本 - 环境变量样板
# 复制此文件到 .env，填入实际值。
# .env 已在 .gitignore 内，绝不要提交真实值进 git。

# ============================================================
# 数据库（SQLite）
# ============================================================
# 本地开发默认不用改，会在项目根目录生成 dev.db。
# Docker 部署时 compose 会覆盖为 file:/app/dev.db，并把 ./dev.db 挂载进去。
DATABASE_URL="file:./dev.db"

# ============================================================
# NextAuth v5
# ============================================================
# 用 `openssl rand -base64 32` 生成一个长随机串
AUTH_SECRET="replace-me-with-random-64-char-string"

# Docker 本地预览保持 http://localhost:3000。
# 生产部署时改为正式域名，例如 https://finance.dengche.cc。
AUTH_URL="http://localhost:3000"

# ============================================================
# 本地上传凭证
# ============================================================
# 凭证图片写入 ./uploads。
# Docker 部署时 compose 会把 ./uploads 挂载到容器 /app/uploads。
# 备份生产数据时需要同时备份 dev.db 和 uploads/。
