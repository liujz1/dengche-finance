# 项目损益账本 — 环境变量样板
# 复制此文件到 .env，填入实际值。
# .env 已在 .gitignore 内，绝不要提交真实值进 git。

# ============================================================
# 数据库（Neon Postgres）
# ============================================================
# 在 https://neon.tech 创建项目后复制 connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ============================================================
# NextAuth v5
# ============================================================
# 用 `openssl rand -base64 32` 生成一个长随机串
AUTH_SECRET="replace-me-with-random-64-char-string"

# 部署到 Vercel 时改为正式域名 https://finance.dengche.cc
AUTH_URL="http://localhost:3000"

# ============================================================
# Cloudflare R2（图片证据存储，S3 兼容）
# ============================================================
# 在 dash.cloudflare.com → R2 → Manage API tokens 创建
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="dengche-finance-evidence"

# R2 公共访问 URL（如果配置了 custom domain 用 custom，否则用 r2.dev 子域）
R2_PUBLIC_URL="https://your-bucket.r2.dev"
